# Telegram Bot Token (Telegram'da @BotFather üzerinden alınır)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Google Gemini API Anahtarı (Google AI Studio üzerinden alınır)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Sizin Telegram Kullanıcı ID'niz (Botun sahibi / Yönetici)
# Öğrenmek için Telegram'da @userinfobot'a /start yazabilirsiniz.
# Boş bırakırsanız güvenlik kapalı (herkese açık) olur; ID yazarsanız SADECE SİZ ve izin verdikleriniz girebilir!
ADMIN_TELEGRAM_ID=YOUR_TELEGRAM_USER_ID

# Google Canlı Ses Modeli (Varsayılan: gemini-3.8-live veya gemini-2.5-flash)
GEMINI_LIVE_MODEL=gemini-3.8-live

# Sunucu Portu
PORT=3000

# Mini App HTTPS URL'si
WEBAPP_URL=https://your-domain.ngrok-free.app
