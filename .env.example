# Telegram Bot Token (Telegram'da @BotFather üzerinden alınır)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Google Gemini API Anahtarı (Google AI Studio üzerinden alınır)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Google Canlı Ses Modeli (Varsayılan: gemini-3.8-live veya gemini-2.5-flash)
GEMINI_LIVE_MODEL=gemini-3.8-live

# Sunucu Portu
PORT=3000

# Mini App HTTPS URL'si (Telegram Mini App'ler HTTPS gerektirir)
# Render/Koyeb kullanıyorsanız onların verdiği link; yerel test için ngrok linki
WEBAPP_URL=https://your-domain.ngrok-free.app
